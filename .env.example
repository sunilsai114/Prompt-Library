# Default, free: get a key at https://aistudio.google.com/apikey
# Keep billing OFF on the underlying Cloud project — that's what keeps a
# leaked key from ever costing money, it just gets rate-limited instead.
# Also restrict the key (API restrictions -> Generative Language API only).
GEMINI_API_KEY=

# Optional upgrade: if set, this takes priority over GEMINI_API_KEY.
ANTHROPIC_API_KEY=
